<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inchiscope_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, parameters, and rosbag2 recording configuration for the Inchiscope stack.</description>
  <maintainer email="ed20j7w@leeds.ac.uk">Inchiscope</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>inchiscope_serial_bridge</exec_depend>
  <exec_depend>inchiscope_pba_control</exec_depend>
  <exec_depend>inchiscope_ab_control</exec_depend>
  <exec_depend>inchiscope_control</exec_depend>
  <exec_depend>inchiscope_aurora</exec_depend>
  <exec_depend>inchiscope_camera</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
