<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inchiscope_camera</name>
  <version>0.1.0</version>
  <description>Publishes the NanEye tip camera feed, grabbed off a USB capture card as a standard V4L2/UVC device.</description>
  <maintainer email="ed20j7w@leeds.ac.uk">Inchiscope</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
