# colcon / ROS2
build/
install/
log/

# PlatformIO
firmware/**/.pio/
firmware/**/.vscode/

# Proprietary vendor SDKs (not redistributable -- see inchiscope_aurora docstring)
third_party/

# Aurora SROM files -- tied to a specific physical sensor's characterisation,
# not source (see src/inchiscope_bringup/config/sroms/README.md)
*.rom

# Python
__pycache__/
*.pyc
.pytest_cache/

# rosbag2 output
*_bag/
rosbag2_*/

# calibrate_camera.py scratch output -- the canonical, committed calibration
# lives at src/inchiscope_bringup/config/camera_info.yaml (wired into
# camera_node's camera_info_path); these are the raw capture frames and
# whatever camera_info.yaml calibrate_camera.py writes if run from its
# default --out-dir/--out inside scripts/, not something to duplicate/track.
src/inchiscope_camera/scripts/calib_frames/
src/inchiscope_camera/scripts/camera_info.yaml

# extract_and_select's --out-dir scratch inspection output -- not something to track
stage2_frames/
